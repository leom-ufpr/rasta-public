\if{html}{\out{<a id="method-RastaStash-bootstrap_uncertainty"></a>}}
\if{latex}{\out{\hypertarget{method-RastaStash-bootstrap_uncertainty}{}}}
\subsection{Method \code{bootstrap_uncertainty()}}{
Bootstraps uncertainty.
\subsection{Usage}{
\if{html}{\out{<div class="r">}}\preformatted{RastaStash$bootstrap_uncertainty(
  bs_reps = self$get_rep_count(),
  bs_matrix = base::matrix()
)}\if{html}{\out{</div>}}
}

\subsection{Arguments}{
\if{html}{\out{<div class="arguments">}}
\describe{
\item{\code{bs_reps}}{An integer corresponding to number of desired
pseudo-replicates. If omitted, will default to the number of
replicates in the stash.}

\item{\code{bs_matrix}}{A design matrix used to enforce the repeated
measures design. If bs_matrix is passed to this method, bs_reps is
ignored. See details for more information.}
}
\if{html}{\out{</div>}}
}
\subsection{Returns}{
A list with two entries: a vector with the bootstrapped
uncertainty value for each pseudo-replicate and the design matrix.
}
\subsection{Examples}{
\if{html}{\out{<div class="r example copy">}}
\preformatted{\dontrun{ # ANN uncertainty will be bootstrapped using 1000
# pseudo-replicates
ann_bs_list <- ann_rs$bootstrap_uncertainty( bs_reps = 1000 )
ann_bs_uncertainty <- ann_bs_list$bs_uncertainty
# Uses the same matrix to enforce the repeated measures design
# when computing the bootstrapped uncertainty for GLM
glm_bs_list <- glm_rs$bootstrap_uncertainty( bs_matrix =
    ann_bs_list$bs_matrix ) }
}
\if{html}{\out{</div>}}

}

}
